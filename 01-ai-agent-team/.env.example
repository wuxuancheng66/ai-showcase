# ============================================================
# AI Agent Team 环境变量模板
# 使用：cp .env.example .env 然后填写真实值
# 安全：.env 已在 .gitignore 中，密钥永远不会进入代码仓库
# ============================================================

# ---- LLM 配置（必填）----
# 任何 OpenAI 兼容接口均可：OpenAI / DeepSeek / 通义千问 / 智谱GLM / 月之暗面等
OPENAI_API_KEY=sk-your-key-here
# DeepSeek 示例：      https://api.deepseek.com/v1      模型 deepseek-chat
# 通义千问 示例：      https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
# 智谱GLM  示例：      https://open.bigmodel.cn/api/paas/v4               模型 glm-4-plus
# OpenAI   示例：      https://api.openai.com/v1        模型 gpt-4o-mini
OPENAI_BASE_URL=https://api.deepseek.com/v1
DEFAULT_MODEL=deepseek-chat

# ---- 联网搜索（不配置则自动降级为离线模式，系统仍可运行）----
# Tavily 申请：https://tavily.com  （每月 1000 次免费）
TAVILY_API_KEY=
# SerpAPI 备用：https://serpapi.com
SERPAPI_API_KEY=

# ---- 可选基础设施（docker compose up -d 后可启用）----
# ChromaDB 向量库：留空则使用本地 JSON 文件记忆
CHROMA_HOST=
CHROMA_PORT=8000
# Redis 预留扩展位
REDIS_URL=

# ---- 运行控制 ----
# Token 总预算（输入+输出），超出自动终止任务，0 表示不限制
TOKEN_BUDGET=300000
# 文件工具沙箱根目录（读写仅限该目录内）
WORKSPACE_ROOT=./workspace
# 默认关闭 LangSmith 上传（保护隐私），如需追踪改为 true 并配置 LANGCHAIN_API_KEY
LANGCHAIN_TRACING_V2=false
